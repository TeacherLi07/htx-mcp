# Required for authenticated account/trading tools.
HTX_API_KEY=
HTX_API_SECRET=

# Separate, read/write credentials used only by scripts/switch_to_non_unified_account.py.
# Do not reuse the MCP server credentials and do not commit their values.
HTX_SWITCH_API_KEY=
HTX_SWITCH_API_SECRET=
HTX_SWITCH_FUTURES_API_BASE_URL=https://api.hbdm.com
HTX_SWITCH_TIMEOUT_SECONDS=20

# Optional. Default: https://api.huobi.pro
HTX_API_BASE_URL=https://api.huobi.pro
# Official USDT-margined contracts host. Change only if your account/region uses another HTX host.
HTX_FUTURES_API_BASE_URL=https://api.hbdm.com
HTX_TIMEOUT_SECONDS=20
HTX_SPOT_ACCOUNT_ID=

# Keep false for read-only operation. Mutations also require confirm=true.
HTX_ENABLE_TRADING=false
# Independent gate for all U-margined swap mutations. Keep false for unified
# accounts or any deployment that should permit spot trading only.
HTX_ENABLE_SWAP_TRADING=true
# Optional toolset allow-list. Empty uses analysis,planning,ops.
# Example: HTX_TOOLSETS=analysis,planning
HTX_TOOLSETS=

# Optional explicit proxy for HTX traffic. HTTP CONNECT proxy example:
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897
# NO_PROXY=

# stdio is the safest/default transport for Claude Desktop, Cursor, etc.
MCP_TRANSPORT=stdio
# Logs default to ~/.htxmcp/htx-mcp.log and never use stderr during normal operation.
# DEBUG and INFO include successful tool inputs/outputs; WARNING suppresses them.
# Old files are uncompressed and retained indefinitely. Set 0 to let logrotate own rotation.
HTX_LOG_LEVEL=INFO
HTX_LOG_DIR=
HTX_LOG_MAX_BYTES=10485760
