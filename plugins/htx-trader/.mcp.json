{
  "mcpServers": {
    "htx": {
      "command": "uv",
      "args": ["run", "htx-mcp"],
      "cwd": "/workspace/htx-mcp",
      "env": {
        "HTX_ENABLE_TRADING": "false",
        "HTX_TOOLSETS": "analysis,planning,ops"
      },
      "env_vars": ["HTX_API_KEY", "HTX_API_SECRET"]
    }
  }
}
